# Copy this file to .env and fill in your values.
# On Linux, set AIRFLOW_UID to the output of `id -u`; on Windows/macOS 50000 is fine.
AIRFLOW_UID=50000

# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: Slack incoming-webhook URL for task failure alerts (blank = log only).
SLACK_WEBHOOK_URL=
